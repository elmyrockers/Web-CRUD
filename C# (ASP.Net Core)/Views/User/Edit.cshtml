		<div class="container">
			<section class="row justify-content-center mt-5">
				<div class="col-6 p-5 bg-white rounded-5">
					<h1 class="mb-4">Edit User #{{ user.ID }}</h1>
					<form method="post">
						<input type="hidden" name="id" value="{{ user.ID }}">
						<div class="mb-3 row">
							<label for="name" class="col-sm-2 col-form-label">Name</label>
							<div class="col-sm-10">
								<div class="input-group">
									<span class="input-group-text">
										<i class="fa-solid fa-user"></i>
									</span>
									<input type="text" class="form-control" id="name" name="name" value="{{ user.Name }}" required>
								</div>
							</div>
						</div>
						<div class="mb-3 row">
							<label for="email" class="col-sm-2 col-form-label">Email</label>
							<div class="col-sm-10">
								<div class="input-group">
									<span class="input-group-text">
										<i class="fa-solid fa-at"></i>
									</span>
									<input type="email" class="form-control" id="email" name="email" value="{{ user.Email }}" required>
								</div>
							</div>
						</div>
						<div class="mb-3 row">
							<label for="website" class="col-sm-2 col-form-label">Website</label>
							<div class="col-sm-10">
								<div class="input-group">
									<span class="input-group-text">
										<i class="fa-solid fa-globe"></i>
									</span>
									<input type="url" class="form-control" id="website" name="website" value="{{ user.Website }}" required>
								</div>
							</div>
						</div>
						<div class="row">
							<div class="col">
								<button type="submit" class="btn btn-dark float-end font-weight-bold">
									Save <i class="fa-solid fa-floppy-disk ms-1"></i>
								</button>
							</div>
						</div>
					</form>
				</div>
			</section>
		</div>
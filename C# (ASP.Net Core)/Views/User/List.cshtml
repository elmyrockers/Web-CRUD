@using WebCRUD.Models

		<div class="container">
			<section class="row mt-5">
				<div class="col p-5 bg-white rounded-5">
					@Html.Raw(ViewBag.Flash)
					<h1>List of Users:</h1>
					<table class="table table-bordered table-hover">
						<thead class="table-dark">
							<tr>
								<th>ID</th>
								<th>Name</th>
								<th>Email</th>
								<th>Website</th>
								<th>Created At</th>
								<th>Updated At</th>
								<th>Action</th>
							</tr>
						</thead>
						<tbody>
							@foreach( var user in Model ){
								<tr>
									<td>@user.Id</td>
									<td>@user.Name</td>
									<td>@user.Email</td>
									<td>@user.Website</td>
									<td>@user.CreatedAt</td>
									<td>@user.UpdatedAt</td>
									<td>
										<div class="btn-group" role="group">
											<a class="btn btn-primary" href="/users/edit/@user.Id">
												<i class="fa-regular fa-pen-to-square"></i>
											</a>
											<a class="btn btn-danger" href="/users/delete/@user.Id">
												<i class="fa-regular fa-trash-can"></i>
											</a>
										</div>
									</td>
								</tr>
							}
						</tbody>
					</table>
					<a class="btn btn-dark" href="/users/new">
						New User
						<i class="fa-solid fa-user-plus ms-1"></i>
					</a>
				</div>
			</section>			
		</div>